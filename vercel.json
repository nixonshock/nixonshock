{
  "name": "nixonshock",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/bip11", "destination": "/bip110", "permanent": true },
    { "source": "/(.*)", "destination": "https://nixonshock.com/btsea/$1", "permanent": true, "has": [{ "type": "host", "value": "btsea.nixonshock.com" }] }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
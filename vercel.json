{
  "name": "nixonshock",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/btsea",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/btsea/(.*)",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/beetc",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/beetc/(.*)",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/bteec",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/bteec/(.*)",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/bteac",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/bteac/(.*)",
      "destination": "/beeteesea",
      "permanent": false
    },
    {
      "source": "/bip11",
      "destination": "/bip110",
      "permanent": true
    },
    {
        "source": "/beeteasea",
        "destination": "/beeteesea",
        "permanent": false
      },
      {
        "source": "/fight",
        "destination": "/battle",
        "permanent": true
      },
      {
        "source": "/fight/(.*)",
        "destination": "/battle",
        "permanent": true
      }
    ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "beeteesea.nixonshock.com"
        }
      ],
      "destination": "/beeteesea"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "battle.nixonshock.com"
        }
      ],
      "destination": "/battle"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "matrix.nixonshock.com"
        }
      ],
      "destination": "/matrix"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/beeteesea/(donate|blockheight)\\.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
